{
  "name": "drakakisgeo/billit",
  "description": "The PHP client for the Billit.io API, with first-class Laravel support",
  "keywords": ["billit", "invoicing", "mydata", "aade", "api", "client", "laravel"],
  "homepage": "https://github.com/drakakisgeo/billit",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "George Drakakis",
      "email": "george@drakakis.gr"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "suggest": {
    "illuminate/support": "Required to use the Laravel service provider and facade (^12.0|^13.0)."
  },
  "autoload": {
    "psr-4": {
      "Drakakisgeo\\Billit\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drakakisgeo\\Billit\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Drakakisgeo\\Billit\\BillitServiceProvider"
      ],
      "aliases": {
        "Billit": "Drakakisgeo\\Billit\\Facades\\Billit"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
